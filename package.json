    "node": ">=22"
  },
  "keywords": [
    "scuba",
    "diving",
    "geotag",
    "exif",
    "garmin",
    "fit",
    "underwater-photography"
  ],
  "devDependencies": {
    "@garmin/fitsdk": "^21.141.0"
  }
}
